{
  "expo": {
    "name": "Diário de Obra Mobile",
    "slug": "diario-de-obra-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [["expo-image-picker", { "photosPermission": "Permitir selecionar fotos para o diário da obra.", "cameraPermission": "Permitir fotografar o andamento da obra.", "microphonePermission": false }]],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
